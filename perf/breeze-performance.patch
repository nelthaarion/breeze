+		if !strings.HasPrefix(got, "[Breeze][") || !strings.HasSuffix(got, "] GET /hello -> 200 ("+strings.SplitN(strings.SplitN(got, "(", 2)[1], ")", 2)[0]+")\n") {
+			t.Fatalf("buffered=%v: unexpected line %q", opts.Buffered, got)
+		}
+	}
+}
