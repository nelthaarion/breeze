@@ -0,0 +1,80 @@
+package breeze
+
+import (
+	"fmt"
+	"testing"
+)
+
+func trieNoop(*Context) error { return nil }
+
+// A GitHub-API-shaped table: the shape on which the ordered scan degrades.
+func trieRESTTable() (*Router, []string) {
+	r := NewRouter()
+	res := []string{"users", "orgs", "teams", "repos", "issues", "pulls", "gists", "hooks", "keys", "labels", "milestones",
+		"releases", "events", "notifications", "projects", "boards", "cards", "columns", "assets", "comments", "reviews",
+		"commits", "branches", "tags", "forks", "stars", "watchers", "invites", "billing", "audit"}
+	for _, n := range res {
+		r.Handle(GET, "/api/v1/"+n, trieNoop)
+		r.Handle(POST, "/api/v1/"+n, trieNoop)
+		r.Handle(GET, "/api/v1/"+n+"/:a", trieNoop)
+		r.Handle(PUT, "/api/v1/"+n+"/:a", trieNoop)
+		r.Handle(DELETE, "/api/v1/"+n+"/:a", trieNoop)
+		r.Handle(GET, "/api/v1/"+n+"/:a/sub", trieNoop)
+		r.Handle(GET, "/api/v1/"+n+"/:a/sub/:b", trieNoop)
+		r.Handle(POST, "/api/v1/"+n+"/:a/sub", trieNoop)
+	}
+	for _, p := range []string{"/health", "/version", "/metrics", "/api/v1/ping"} {
+		r.Handle(GET, p, trieNoop)
+	}
+	return r, []string{"/api/v1/users/17", "/api/v1/orgs/9/sub", "/api/v1/teams/3/sub/4", "/api/v1/gists/5",
+		"/api/v1/commits/8/sub/2", "/api/v1/billing/1", "/api/v1/audit/6/sub/1", "/health", "/api/v1/ping", "/api/v1/stars/12/sub"}
+}
+
+func BenchmarkRouterLookupREST244(b *testing.B) {
+	r, paths := trieRESTTable()
+	req := &HTTPRequest{Method: GET}
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		req.Path = paths[i%len(paths)]
+		rt, params, _ := r.lookup(req)
+		if rt == nil {
+			b.Fatal("no route for ", req.Path)
+		}
+		if params != nil {
+			releaseParams(params)
+		}
+	}
+}
+
+// Lookup cost as the table grows: the ordered scan is O(routes), the trie O(path
+// depth). Paths are the last-registered resource (worst case for a scan), one in
+// the middle, and the first.
+func BenchmarkRouterLookupScaling(b *testing.B) {
+	for _, n := range []int{25, 100, 250, 1000} {
+		b.Run(fmt.Sprintf("resources=%d", n), func(b *testing.B) {
+			r := NewRouter()
+			for i := 0; i < n; i++ {
+				base := fmt.Sprintf("/api/v1/res%d", i)
+				r.Handle(GET, base, trieNoop)
+				r.Handle(GET, base+"/:id", trieNoop)
+				r.Handle(GET, base+"/:id/sub", trieNoop)
+				r.Handle(GET, base+"/:id/sub/:n", trieNoop)
+			}
+			paths := []string{fmt.Sprintf("/api/v1/res%d/42/sub/7", n-1), fmt.Sprintf("/api/v1/res%d/42", n/2), "/api/v1/res0/1"}
+			req := &HTTPRequest{Method: GET}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				req.Path = paths[i%3]
+				rt, params, _ := r.lookup(req)
+				if rt == nil {
+					b.Fatal("no route")
+				}
+				if params != nil {
+					releaseParams(params)
+				}
+			}
+		})
+	}
+}
diff -ruN --strip-trailing-cr -x perf a/router_trie.go b/router_trie.go
--- a/router_trie.go	1970-01-01 00:00:00.000000000 +0000
+++ b/router_trie.go	2026-10-27 21:10:53.851617078 +0000
@@ -0,0 +1,171 @@
+package breeze
+
+// maxRouteOrder is larger than any registration index.
+const maxRouteOrder = int(^uint(0) >> 1)
+
+// segNodeLinear is how many static children a node finds by scanning its keys
+// before it also builds a map: small fan-outs are cheaper to scan than to hash.
+const segNodeLinear = 8
+
+// segNode is a node of a method bucket's segment trie.
+//
+// A pattern is a path of segments. A literal segment descends into the static
+// child of that name, a :param segment into the node's single param child (the
+// parameter names are irrelevant to matching, they only matter when the params
+// map is built from the winning route), and a trailing *wildcard marks the node
+// the route ends on. The route is stored on that node as exact (it matches only
+// when the request ends there) or wild (it matches when the request ends there or
+// continues past it).
+//
+// min is the lowest registration index of any route in the subtree. match uses
+// it to skip subtrees that cannot beat a route it already holds, which is what
+// lets a depth-first walk return the first-registered match without visiting
+// every candidate: the result is identical to scanning the routes in order.
+type segNode struct {
+	keys  []string
+	kids  []*segNode
+	index map[string]*segNode // mirrors keys/kids once len(keys) > segNodeLinear
+	param *segNode
+	exact *route
+	wild  *route
+	min   int
+}
+
+func newSegNode() *segNode { return &segNode{min: maxRouteOrder} }
+
+func (n *segNode) child(seg string) *segNode {
+	if n.index != nil {
+		return n.index[seg]
+	}
+	for i, k := range n.keys {
+		if k == seg {
+			return n.kids[i]
+		}
+	}
+	return nil
+}
+
+func (n *segNode) staticChild(seg string) *segNode {
+	if c := n.child(seg); c != nil {
+		return c
+	}
+	c := newSegNode()
+	n.keys = append(n.keys, seg)
+	n.kids = append(n.kids, c)
+	switch {
+	case n.index != nil:
+		n.index[seg] = c
+	case len(n.keys) > segNodeLinear:
+		n.index = make(map[string]*segNode, 2*len(n.keys))
+		for i, k := range n.keys {
+			n.index[k] = n.kids[i]
+		}
+	}
+	return c
+}
+
+func (n *segNode) paramChild() *segNode {
+	if n.param == nil {
+		n.param = newSegNode()
+	}
+	return n.param
+}
+
+// insertTrie adds rt to the bucket's trie. Routes arrive in registration order,
+// so rt.order only grows and the first route to reach a node sets its min.
+func (idx *methodIndex) insertTrie(rt *route) {
+	if idx.root == nil {
+		idx.root = newSegNode()
+	}
+	cur := idx.root
+	if rt.order < cur.min {
+		cur.min = rt.order
+	}
+	for i, seg := range rt.segments {
+		if rt.paramIndex[i] {
+			cur = cur.paramChild()
+		} else {
+			cur = cur.staticChild(seg)
+		}
+		if rt.order < cur.min {
+			cur.min = rt.order
+		}
+	}
+	// A later route of the same shape ends on the same node and matches exactly
+	// the requests the earlier one matches, so it could never win: keep the first.
+	if rt.hasWildcard {
+		if cur.wild == nil {
+			cur.wild = rt
+		}
+	} else if cur.exact == nil {
+		cur.exact = rt
+	}
+}
+
+// match walks segs[depth:] below n and returns the matching route with the lowest
+// registration index, or best when nothing below n beats it.
+func (n *segNode) match(segs []string, depth int, best *route, bestIdx int) (*route, int) {
+	if n.min >= bestIdx {
+		return best, bestIdx
+	}
+	// Reaching n means depth request segments matched, which is all a wildcard
+	// anchored here needs: it matches the remaining segments, however many.
+	if w := n.wild; w != nil && w.order < bestIdx {
+		best, bestIdx = w, w.order
+	}
+	if depth == len(segs) {
+		if e := n.exact; e != nil && e.order < bestIdx {
+			best, bestIdx = e, e.order
+		}
+		return best, bestIdx
+	}
+	if c := n.child(segs[depth]); c != nil {
+		best, bestIdx = c.match(segs, depth+1, best, bestIdx)
+	}
+	if n.param != nil {
+		best, bestIdx = n.param.match(segs, depth+1, best, bestIdx)
+	}
+	return best, bestIdx
+}
+
+// scan is the ordered scan: the first route of the bucket with this method that
+// matches. bucketOther mixes methods and is small, so it keeps this.
+func (idx *methodIndex) scan(method Method, segs []string) *route {
+	for _, rt := range idx.routes {
+		if rt.method == method && rt.matchesSegments(segs) {
+			return rt
+		}
+	}
+	return nil
+}
+
+// bindParams builds the params map for the winning route. The map is nil for a
+// route with neither parameters nor a wildcard.
+func bindParams(rt *route, path string, segs []string) map[string]string {
+	if !rt.hasWildcard && rt.paramCount == 0 {
+		return nil
+	}
+	params := acquireParams()
+	for i, rseg := range rt.segments {
+		if rt.paramIndex[i] {
+			params[rseg[1:]] = segs[i]
+		}
+	}
+	if rt.hasWildcard {
+		params[rt.wildcardName] = pathTail(path, segs, len(rt.segments))
+	}
+	return params
+}
+
+// pathTail returns strings.Join(segs[k:], "/") without building a new string:
+// segs are the '/'-separated pieces of path, so the join is a suffix of it.
+func pathTail(path string, segs []string, k int) string {
+	if k >= len(segs) {
+		return ""
+	}
+	off := 0
+	for i := 0; i < k; i++ {
+		off += len(segs[i]) + 1
+	}
+	return path[off:]
+}
diff -ruN --strip-trailing-cr -x perf a/router_trie_test.go b/router_trie_test.go
--- a/router_trie_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/router_trie_test.go	2026-10-27 21:10:53.866097600 +0000
@@ -0,0 +1,205 @@
+package breeze
+
+import (
+	"fmt"
+	"math/rand"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// lookupScanOracle is the ordered scan Router.lookup used before the segment trie,
+// kept verbatim as an executable specification: the first route in registration
+// order that matches wins.
+func lookupScanOracle(r *Router, req *HTTPRequest) (*route, map[string]string) {
+	path := req.Path
+	if len(path) > 0 && path[0] == '/' {
+		path = path[1:]
+	}
+	if len(path) > 0 && path[len(path)-1] == '/' {
+		path = path[:len(path)-1]
+	}
+	idx := &r.byMethod[methodBucket(req.Method)]
+	var reqSegments []string
+	if path != "" {
+		reqSegments = strings.Split(path, "/")
+	}
+	nReq := len(reqSegments)
+	checkMethod := methodBucket(req.Method) == bucketOther
+	for _, rt := range idx.routes {
+		if checkMethod && rt.method != req.Method {
+			continue
+		}
+		if rt.hasWildcard {
+			if nReq < len(rt.segments) {
+				continue
+			}
+			match := true
+			for i, rseg := range rt.segments {
+				if rt.paramIndex[i] {
+					continue
+				}
+				if rseg != reqSegments[i] {
+					match = false
+					break
+				}
+			}
+			if !match {
+				continue
+			}
+			params := map[string]string{}
+			for i, rseg := range rt.segments {
+				if rt.paramIndex[i] {
+					params[rseg[1:]] = reqSegments[i]
+				}
+			}
+			params[rt.wildcardName] = strings.Join(reqSegments[len(rt.segments):], "/")
+			return rt, params
+		}
+		if len(rt.segments) != nReq {
+			continue
+		}
+		match := true
+		for i, rseg := range rt.segments {
+			if !rt.paramIndex[i] && rseg != reqSegments[i] {
+				match = false
+				break
+			}
+		}
+		if !match {
+			continue
+		}
+		if rt.paramCount > 0 {
+			params := map[string]string{}
+			for i, rseg := range rt.segments {
+				if rt.paramIndex[i] {
+					params[rseg[1:]] = reqSegments[i]
+				}
+			}
+			return rt, params
+		}
+		return rt, nil
+	}
+	return nil, nil
+}
+
+func trieRandPattern(rng *rand.Rand) string {
+	alphabet := []string{"a", "b", "c", "users", "x", ""}
+	segs := make([]string, 0, 6)
+	for i, n := 0, rng.Intn(5); i < n; i++ {
+		if rng.Intn(5) < 3 {
+			segs = append(segs, alphabet[rng.Intn(len(alphabet))])
+		} else {
+			segs = append(segs, fmt.Sprintf(":p%d", rng.Intn(3)))
+		}
+	}
+	if rng.Intn(5) == 0 {
+		if rng.Intn(2) == 0 {
+			segs = append(segs, "*")
+		} else {
+			segs = append(segs, fmt.Sprintf("*w%d", rng.Intn(2)))
+		}
+	}
+	return "/" + strings.Join(segs, "/")
+}
+
+func trieRandPath(rng *rand.Rand) string {
+	pool := []string{"a", "b", "c", "users", "x", "", "zzz", ":p0", "*"}
+	segs := make([]string, rng.Intn(6))
+	for i := range segs {
+		segs[i] = pool[rng.Intn(len(pool))]
+	}
+	p := strings.Join(segs, "/")
+	if rng.Intn(10) != 0 {
+		p = "/" + p
+	}
+	if rng.Intn(5) == 0 {
+		p += "/"
+	}
+	return p
+}
+
+// The segment trie must return exactly what the ordered scan returned: the same
+// route, and the same params, on random route tables full of overlaps (a :param
+// registered before a literal it shadows, duplicate shapes, wildcards that also
+// match zero segments, empty segments, several methods).
+func TestRouterTrieMatchesOrderedScan(t *testing.T) {
+	methods := []Method{GET, GET, GET, POST, PUT, Method("HEAD"), Method("PURGE")}
+	rng := rand.New(rand.NewSource(20261028))
+	checked, hits := 0, 0
+	for table := 0; table < 1500; table++ {
+		r := NewRouter()
+		for i, n := 0, 1+rng.Intn(45); i < n; i++ {
+			r.Handle(methods[rng.Intn(len(methods))], trieRandPattern(rng), trieNoop)
+		}
+		for q := 0; q < 250; q++ {
+			req := &HTTPRequest{Method: methods[rng.Intn(len(methods))], Path: trieRandPath(rng)}
+			gotRt, gotParams, _ := r.lookup(req)
+			wantRt, wantParams := lookupScanOracle(r, req)
+			checked++
+			if gotRt != nil {
+				hits++
+			}
+			if gotRt != wantRt {
+				t.Fatalf("table %d: %s %q: route mismatch: got %v want %v", table, req.Method, req.Path, patternOf(gotRt), patternOf(wantRt))
+			}
+			if (gotParams == nil) != (wantParams == nil) || (gotParams != nil && !reflect.DeepEqual(gotParams, wantParams)) {
+				t.Fatalf("table %d: %s %q (%s): params got %v want %v", table, req.Method, req.Path, patternOf(gotRt), gotParams, wantParams)
+			}
+			if gotParams != nil {
+				releaseParams(gotParams)
+			}
+		}
+	}
+	if hits < checked/10 {
+		t.Fatalf("generator too sparse: only %d of %d lookups matched a route", hits, checked)
+	}
+}
+
+func patternOf(rt *route) string {
+	if rt == nil {
+		return "<none>"
+	}
+	return string(rt.method) + " " + rt.pattern
+}
+
+func TestRouterTrieFirstRegisteredWins(t *testing.T) {
+	r := NewRouter()
+	r.Handle(GET, "/users/:id", trieNoop)   // 0
+	r.Handle(GET, "/users/me", trieNoop)    // 1: shadowed by 0, as before
+	r.Handle(GET, "/files/*path", trieNoop) // 2
+	r.Handle(GET, "/files", trieNoop)       // 3: shadowed, the wildcard matches zero segments
+	r.Handle(GET, "/a/b/c", trieNoop)       // 4
+	r.Handle(GET, "/a/:x/d", trieNoop)      // 5
+	r.Handle(GET, "/", trieNoop)            // 6
+	cases := []struct {
+		path   string
+		want   int
+		params map[string]string
+	}{
+		{"/users/me", 0, map[string]string{"id": "me"}},
+		{"/users/42", 0, map[string]string{"id": "42"}},
+		{"/files", 2, map[string]string{"path": ""}},
+		{"/files/", 2, map[string]string{"path": ""}},
+		{"/files/x/y/z", 2, map[string]string{"path": "x/y/z"}},
+		{"/files/x//y", 2, map[string]string{"path": "x//y"}},
+		{"/a/b/c", 4, nil},
+		{"/a/q/d", 5, map[string]string{"x": "q"}},
+		{"/", 6, nil},
+		{"/nope", -1, nil},
+		{"/users", -1, nil},
+		{"/users/1/2", -1, nil},
+	}
+	for _, c := range cases {
+		rt, params, _ := r.lookup(&HTTPRequest{Method: GET, Path: c.path})
+		switch {
+		case c.want < 0 && rt != nil:
+			t.Errorf("%s: expected no route, got %s", c.path, patternOf(rt))
+		case c.want >= 0 && rt != r.routes[c.want]:
+			t.Errorf("%s: got %s, want %s", c.path, patternOf(rt), patternOf(r.routes[c.want]))
+		}
+		if len(params) != len(c.params) || (len(c.params) > 0 && !reflect.DeepEqual(params, c.params)) {
+			t.Errorf("%s: params %v, want %v", c.path, params, c.params)
+		}
+	}
+}
diff -ruN --strip-trailing-cr -x perf a/static_union.go b/static_union.go
--- a/static_union.go	1970-01-01 00:00:00.000000000 +0000
+++ b/static_union.go	2026-10-28 09:21:29.857682365 +0000
@@ -0,0 +1,81 @@
+package breeze
+
+import (
+	"sync/atomic"
+	"unsafe"
+)
+
+// staticUnion is the merge of two static header blocks (see SetHeaderStatic): the
+// concatenated wire bytes and the combined lookup map. Both inputs are immutable
+// per middleware instance, so the merge is the same for every request and is
+// computed once instead of on each one.
+//
+// The inputs are retained here on purpose: the cache is keyed by their addresses,
+// and holding them keeps those addresses from being recycled for different data.
+type staticUnion struct {
+	a, b   []byte
+	am, bm map[string]string
+
+	block  []byte
+	lookup map[string]string
+}
+
+// maxStaticUnions bounds the cache. A program that builds a new pair of static
+// middlewares per request would otherwise grow it without limit; past the bound
+// the merge is simply not cached, which is the old behaviour.
+const maxStaticUnions = 64
+
+var staticUnions atomic.Pointer[[]*staticUnion] // copy-on-write snapshot
+
+func mapID(m map[string]string) unsafe.Pointer { return *(*unsafe.Pointer)(unsafe.Pointer(&m)) }
+
+func (u *staticUnion) is(a []byte, am map[string]string, b []byte, bm map[string]string) bool {
+	return len(u.a) == len(a) && len(u.b) == len(b) &&
+		unsafe.SliceData(u.a) == unsafe.SliceData(a) && unsafe.SliceData(u.b) == unsafe.SliceData(b) &&
+		mapID(u.am) == mapID(am) && mapID(u.bm) == mapID(bm)
+}
+
+func staticUnionOf(a []byte, am map[string]string, b []byte, bm map[string]string) *staticUnion {
+	if cur := staticUnions.Load(); cur != nil {
+		for _, u := range *cur {
+			if u.is(a, am, b, bm) {
+				return u
+			}
+		}
+	}
+	nb := make([]byte, 0, len(a)+len(b))
+	nb = append(nb, a...)
+	nb = append(nb, b...)
+	nm := make(map[string]string, len(am)+len(bm))
+	for k, v := range am {
+		nm[k] = v
+	}
+	for k, v := range bm {
+		nm[k] = v
+	}
+	u := &staticUnion{a: a, b: b, am: am, bm: bm, block: nb, lookup: nm}
+	for {
+		cur := staticUnions.Load()
+		var list []*staticUnion
+		if cur != nil {
+			list = *cur
+			// Another event loop may have added this very pair while we were
+			// merging (every loop misses on its first request). Use its entry
+			// instead of appending a duplicate that would waste a slot.
+			for _, e := range list {
+				if e.is(a, am, b, bm) {
+					return e
+				}
+			}
+		}
+		if len(list) >= maxStaticUnions {
+			return u
+		}
+		next := make([]*staticUnion, len(list)+1)
+		copy(next, list)
+		next[len(list)] = u
+		if staticUnions.CompareAndSwap(cur, &next) {
+			return u
+		}
+	}
+}
diff -ruN --strip-trailing-cr -x perf a/static_union_test.go b/static_union_test.go
--- a/static_union_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/static_union_test.go	2026-10-28 09:21:29.858324620 +0000
@@ -0,0 +1,101 @@
+package breeze
+
+import (
+	"reflect"
+	"sync"
+	"testing"
+	"unsafe"
+)
+
+func TestStaticUnionCachedSharedAndCorrect(t *testing.T) {
+	a := []byte("A: 1\r\n")
+	am := map[string]string{"A": "1"}
+	b := []byte("B: 2\r\nC: 3\r\n")
+	bm := map[string]string{"B": "2", "C": "3"}
+	merge := func() *Context {
+		c := NewContext(GET, "/")
+		c.SetHeaderStatic(a, am)
+		c.SetHeaderStatic(b, bm)
+		return c
+	}
+	c1, c2 := merge(), merge()
+	if got := string(c1.Res.preBuilt); got != "A: 1\r\nB: 2\r\nC: 3\r\n" {
+		t.Fatalf("merged block %q", got)
+	}
+	if want := (map[string]string{"A": "1", "B": "2", "C": "3"}); !reflect.DeepEqual(c1.Res.preHeaders, want) {
+		t.Fatalf("merged lookup %v", c1.Res.preHeaders)
+	}
+	if unsafe.SliceData(c1.Res.preBuilt) != unsafe.SliceData(c2.Res.preBuilt) {
+		t.Fatal("the merge was recomputed instead of shared")
+	}
+	if !c1.Res.headersShared {
+		t.Fatal("shared union must stay copy-on-write")
+	}
+	// A dynamic header after the union must not write through to the shared state.
+	c1.SetHeader("X-Extra", "1")
+	if _, leaked := c2.Res.preHeaders["X-Extra"]; leaked {
+		t.Fatal("SetHeader leaked into the shared union")
+	}
+	if string(a) != "A: 1\r\n" || len(am) != 1 || len(bm) != 2 {
+		t.Fatal("source blocks were modified")
+	}
+	// Different pairs must not collide.
+	d := []byte("D: 4\r\n")
+	dm := map[string]string{"D": "4"}
+	c3 := NewContext(GET, "/")
+	c3.SetHeaderStatic(a, am)
+	c3.SetHeaderStatic(d, dm)
+	if got := string(c3.Res.preBuilt); got != "A: 1\r\nD: 4\r\n" {
+		t.Fatalf("second pair merged to %q", got)
+	}
+}
+
+func TestStaticUnionNoAllocWhenCached(t *testing.T) {
+	a, am := []byte("A: 1\r\n"), map[string]string{"A": "1"}
+	b, bm := []byte("B: 2\r\n"), map[string]string{"B": "2"}
+	c := NewContext(GET, "/")
+	r := c.ensureResponse()
+	run := func() {
+		r.preBuilt, r.preHeaders = nil, nil
+		c.SetHeaderStatic(a, am)
+		c.SetHeaderStatic(b, bm)
+	}
+	run()
+	if n := testing.AllocsPerRun(200, run); n != 0 {
+		t.Fatalf("merging two static blocks allocates %v times per request once cached", n)
+	}
+}
+
+// Every event loop misses on its first request for a pair: concurrent first use
+// must agree on one shared union and must not fill the cache with duplicates.
+func TestStaticUnionConcurrentFirstUse(t *testing.T) {
+	a, am := []byte("A: 1\r\n"), map[string]string{"A": "1"}
+	b, bm := []byte("B: 2\r\n"), map[string]string{"B": "2"}
+	results := make([]*staticUnion, 32)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range results {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			results[i] = staticUnionOf(a, am, b, bm)
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	for _, u := range results {
+		if string(u.block) != "A: 1\r\nB: 2\r\n" || len(u.lookup) != 2 {
+			t.Fatalf("wrong union %q %v", u.block, u.lookup)
+		}
+	}
+	n := 0
+	for _, e := range *staticUnions.Load() {
+		if e.is(a, am, b, bm) {
+			n++
+		}
+	}
+	if n != 1 {
+		t.Fatalf("%d cache entries for one pair, want 1", n)
+	}
+}
