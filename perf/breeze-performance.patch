--- a/middlewares/accept_encoding.go	1970-01-01 00:00:00.000000000 +0000
+++ b/middlewares/accept_encoding.go	2026-10-27 21:17:33.167066652 +0000
@@ -0,0 +1,92 @@
+package middleware
+
+import (
+	"strconv"
+	"strings"
+)
+
+// acceptQ holds the quality values of the three encodings this package can
+// produce, as encodingQValue reports them for the same header.
+type acceptQ struct{ br, gzip, deflate float64 }
+
+func (a acceptQ) of(encoding string) float64 {
+	switch encoding {
+	case "br":
+		return a.br
+	case "gzip":
+		return a.gzip
+	case "deflate":
+		return a.deflate
+	}
+	return 0
+}
+
+// parseAcceptEncoding evaluates an Accept-Encoding header for br, gzip and
+// deflate in one pass without allocating. encodingQValue, which it replaces on
+// the request path, re-split the header with strings.Split for every candidate
+// encoding (up to three times per request, several allocations each).
+//
+// The result is identical to calling encodingQValue once per encoding: the last
+// explicit entry for an encoding wins, then the last "*", then 0. A header with
+// non-ASCII bytes is handed to encodingQValue itself so its Unicode case folding
+// and whitespace rules apply unchanged.
+func parseAcceptEncoding(header string) acceptQ {
+	for i := 0; i < len(header); i++ {
+		if header[i] >= 0x80 {
+			return acceptQ{encodingQValue(header, "br"), encodingQValue(header, "gzip"), encodingQValue(header, "deflate")}
+		}
+	}
+	best := [3]float64{-1, -1, -1}
+	wildcard := -1.0
+	rest := header
+	for {
+		raw, more := rest, false
+		if i := strings.IndexByte(rest, ','); i >= 0 {
+			raw, rest, more = rest[:i], rest[i+1:], true
+		}
+		name, params := raw, ""
+		if i := strings.IndexByte(raw, ';'); i >= 0 {
+			name, params = raw[:i], raw[i+1:]
+		}
+		q := 1.0
+		for params != "" {
+			param := params
+			if i := strings.IndexByte(params, ';'); i >= 0 {
+				param, params = params[:i], params[i+1:]
+			} else {
+				params = ""
+			}
+			param = strings.TrimSpace(param)
+			if eq := strings.IndexByte(param, '='); eq >= 0 && strings.EqualFold(strings.TrimSpace(param[:eq]), "q") {
+				if v, err := strconv.ParseFloat(strings.TrimSpace(param[eq+1:]), 64); err == nil && v >= 0 && v <= 1 {
+					q = v
+				} else {
+					q = 0
+				}
+			}
+		}
+		switch name = strings.TrimSpace(name); {
+		case strings.EqualFold(name, "br"):
+			best[0] = q
+		case strings.EqualFold(name, "gzip"):
+			best[1] = q
+		case strings.EqualFold(name, "deflate"):
+			best[2] = q
+		case name == "*":
+			wildcard = q
+		}
+		if !more {
+			break
+		}
+	}
+	resolve := func(v float64) float64 {
+		if v >= 0 {
+			return v
+		}
+		if wildcard >= 0 {
+			return wildcard
+		}
+		return 0
+	}
+	return acceptQ{resolve(best[0]), resolve(best[1]), resolve(best[2])}
+}
diff -ruN --strip-trailing-cr -x perf a/middlewares/accept_encoding_test.go b/middlewares/accept_encoding_test.go
--- a/middlewares/accept_encoding_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/middlewares/accept_encoding_test.go	2026-10-27 21:17:33.169556741 +0000
@@ -0,0 +1,73 @@
+package middleware
+
+import (
+	"math/rand"
+	"strings"
+	"testing"
+)
+
+func TestParseAcceptEncodingMatchesGeneric(t *testing.T) {
+	names := []string{"br", "gzip", "deflate", "*", "BR", "GZip", "identity", "compress", "x-gzip", " br ", "\tgzip", "deflate ", "", "gzip2", "g zip"}
+	qs := []string{"", ";q=1", ";q=0", ";q=0.5", "; q=0.001", ";Q=0.3", ";q=1.0", ";q=abc", ";q=-1", ";q=2", ";q= 0.7 ", ";q=.5",
+		";q=1e0", ";q=0x1p-1", ";q=", ";level=1;q=0.2", ";q=0.1;q=0.9", ";;q=0.4", ";", "; q = 0.2", ";q=NaN", ";q=+1", ";x=y"}
+	seps := []string{",", ", ", " , ", ",,", ";", ", ,"}
+	rng := rand.New(rand.NewSource(11))
+	for i := 0; i < 300000; i++ {
+		var sb strings.Builder
+		for j, n := 0, rng.Intn(6); j < n; j++ {
+			if j > 0 {
+				sb.WriteString(seps[rng.Intn(len(seps))])
+			}
+			sb.WriteString(names[rng.Intn(len(names))])
+			sb.WriteString(qs[rng.Intn(len(qs))])
+		}
+		h := sb.String()
+		switch rng.Intn(40) {
+		case 0:
+			h += "\u00a0" // non-ASCII: must take the generic path
+		case 1:
+			h = "gz\u0130p, " + h
+		}
+		got := parseAcceptEncoding(h)
+		for _, e := range []string{"br", "gzip", "deflate"} {
+			if got.of(e) != encodingQValue(h, e) {
+				t.Fatalf("header %q, %s: got %v want %v", h, e, got.of(e), encodingQValue(h, e))
+			}
+		}
+	}
+}
+
+var sinkQ acceptQ
+
+func TestParseAcceptEncodingNoAllocs(t *testing.T) {
+	if n := testing.AllocsPerRun(1000, func() { sinkQ = parseAcceptEncoding("gzip, deflate, br;q=0.8, *;q=0.1") }); n != 0 {
+		t.Fatalf("allocates %v times per call", n)
+	}
+}
+
+func BenchmarkAcceptEncodingGeneric(b *testing.B) {
+	b.ReportAllocs()
+	h := "gzip, deflate, br"
+	for i := 0; i < b.N; i++ {
+		for _, e := range []string{"br", "gzip", "deflate"} {
+			if encodingQValue(h, e) <= 0 {
+				continue
+			}
+			break
+		}
+	}
+}
+
+func BenchmarkAcceptEncodingSinglePass(b *testing.B) {
+	b.ReportAllocs()
+	h := "gzip, deflate, br"
+	for i := 0; i < b.N; i++ {
+		q := parseAcceptEncoding(h)
+		for _, e := range []string{"br", "gzip", "deflate"} {
+			if q.of(e) <= 0 {
+				continue
+			}
+			break
+		}
+	}
+}
