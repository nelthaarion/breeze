+	size   int
+	hard   int
+	mu     sync.Mutex // guards buf
+	buf    []byte
+	flushM sync.Mutex // serialises flushes; guards spare and writes to out
+	spare  []byte
+	kick   chan struct{}
+	stop   chan struct{}
+	done   chan struct{}
+	once   sync.Once
+}
