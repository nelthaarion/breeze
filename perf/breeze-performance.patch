+func TestETagCacheIsBoundedAndWritesNothingWhenUnchanged(t *testing.T) {
+	c := NewETagCache()
+	for i := 0; i < 100000; i++ {
+		c.put(fmt.Sprintf("/u/%d", i), "e")
