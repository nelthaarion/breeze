package main

import (
	"fmt"
	"log"
	"runtime"

	"github.com/nelthaarion/breeze/v2"
)

func main() {
	router := breeze.NewRouter()
	RegisterGeneratedRoutes(router)

	pool := breeze.NewEventLoopWorkerPool(runtime.NumCPU())
	app := breeze.New(router, pool)

	engine := breeze.NewTemplateEngine(breeze.TemplateConfig{
		ViewsDir:      "./views",
		ComponentsDir: "./components",
		LayoutFile:    "./views/layout.html",
		DevMode:       true,
	})

	if err := engine.Preload(); err != nil {
		panic(err)
	}

	router.EnableReRender(engine)

	router.View("/", engine, "home", nil)
	router.View("/about", engine, "about", nil)

	router.ServeStatic("/public", "./public")

	// Wires everything added with `breeze add`. Called after the routes above
	// because Router.Use rebuilds each route's middleware chain on every call.
	RegisterGeneratedFeatures(app, router)

	fmt.Println("Breeze listening on :3000")
	// Run returns when the listener cannot start (the port is taken, or was left in
	// TIME_WAIT by a run that has just stopped) and when the server is stopped. Dropping
	// the error made the first of those look like a clean exit.
	if err := app.Run(3000, true); err != nil {
		log.Fatalf("breeze: %v", err)
	}
}
